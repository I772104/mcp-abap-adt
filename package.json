{
  "name": "@orchestraight.co/mcp-abap-adt",
  "version": "1.1.0",
  "main": "index.js",
  "scripts": {
    "test": "jest --selectProjects=unit",
    "test:unit": "jest --selectProjects=unit",
    "test:integration": "jest --selectProjects=integration",
    "test:all": "jest",
    "test:watch": "jest --selectProjects=unit --watch",
    "test:coverage": "jest --selectProjects=unit --coverage",
    "build": "tsc -p tsconfig.json",
    "start": "node ./dist/index.js",
    "dev": "npx @modelcontextprotocol/inspector node ./dist/index.js",
    "updated": "npm ci && npm run build",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "fix": "npm run format && npm run lint:fix",
    "validate": "npm run check && npm run build && npm run test",
    "review": "node .claude/agents/scripts/run-pr-review.js",
    "review:full": "node .claude/agents/scripts/run-pr-review.js --full",
    "review:quick": "node .claude/agents/scripts/run-pr-review.js --quick",
    "analyze-issue": "node .claude/agents/scripts/run-issue-analyzer.js",
    "status": "node .claude/agents/scripts/run-maintainer-status.js",
    "status:detailed": "node .claude/agents/scripts/run-maintainer-status.js --detailed",
    "status:quick": "node .claude/agents/scripts/run-maintainer-status.js --quick",
    "review:risks": "node .claude/agents/scripts/run-risk-review.js",
    "review:risks-pr": "node .claude/agents/scripts/run-risk-review.js --pr",
    "prepare": "husky || true"
  },
  "keywords": [
    "abap",
    "sap",
    "adt",
    "mcp",
    "model-context-protocol"
  ],
  "author": "SAP SE (forked from orchestraight.co)",
  "description": "ABAP ADT (ABAP Development Tools) MCP Server - Evaluation platform for AI-assisted ABAP development and MCP capability exploration",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.tools.sap/D020426/mcp-abap-adt.git"
  },
  "homepage": "https://github.tools.sap/D020426/mcp-abap-adt#readme",
  "bugs": {
    "url": "https://github.tools.sap/D020426/mcp-abap-adt/issues"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@types/diff": "^7.0.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.10",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.4.1",
    "axios": "^1.16.1",
    "chrome-launcher": "^1.2.1",
    "diff": "^8.0.3",
    "dotenv": "^16.4.7",
    "xml-js": "^1.6.11",
    "xml2js": "^0.6.2"
  }
}
