# Dependency directories
node_modules/

# Build output
dist/
build/
package-lock.json

# Environment variables
.env
.env.local
.env.*.local

# SAP system configuration (contains sensitive URLs and credentials)
.sap-systems.json

# Authentication cookies and temporary files
tmp/
*.backup

# MCP configuration (local only)
.mcp.json

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating System Files
.DS_Store
Thumbs.db

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Test coverage
coverage/
.nyc_output/

# Backup files
*.bak

# Claude Code session and settings
.claude/*
# But allow agents directory (custom agents are part of the project)
!.claude/agents/
# Exclude temp files generated by agents
.claude/agents/temp-*.txt
.claude/agents/temp-*.md
