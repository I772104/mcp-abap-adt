# SAP System Configuration
# Required for:
# - MCP server operation
# - Integration tests (npm run test:integration)
# Note: Unit tests (npm test) do NOT require these credentials
SAP_URL=https://example.com:443
SAP_CLIENT=your_client_number

# Authentication Method 1: Basic Authentication (Optional)
# Use this for development/testing when you have credentials
SAP_USERNAME=your_username
SAP_PASSWORD=your_password

# Authentication Method 2: Built-in Browser SSO (Automatic)
# If username/password are not set, the server uses built-in browser SSO:
# - Chrome launches automatically on first request for SSO login
# - Or call the SapBrowserLogin tool to proactively authenticate
# - Cookies cached to $TMPDIR/mcp-abap-adt/<domain>.json with 12h TTL
# - 401/403 responses auto-retry with re-authentication
#
# Legacy SSO (sap-auth-mcp-main) still works as fallback.
# The server checks these cookie paths before launching browser SSO:
# 1. ./tmp/sap_cookies.json (created by sap_authenticate tool)
# 2. ~/.sap/cookies/sap_cookies.json
# 3. Custom path: AUTH_COOKIE_PATH environment variable
#
# To use SSO:
# 1. Comment out or remove SAP_USERNAME and SAP_PASSWORD
# 2. Browser SSO launches automatically -- no extra setup needed

# Optional: Custom cookie file location
# AUTH_COOKIE_PATH=/path/to/cookie/directory

# Optional: Other settings
SAP_LANGUAGE=en
TLS_REJECT_UNAUTHORIZED=either_1_or_0

